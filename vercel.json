{
  "rewrites": [
    {
      "source": "/admin",
      "destination": "https://choochootortas-admin.vercel.app"
    },
    {
      "source": "/admin/:match*",
      "destination": "https://choochootortas-admin.vercel.app/:match*"
    },
    {
      "source": "/kitchen",
      "destination": "https://choochootortas-kitchen.vercel.app"
    },
    {
      "source": "/kitchen/:match*",
      "destination": "https://choochootortas-kitchen.vercel.app/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "https://choochootortas.vercel.app/$1"
    }
  ]
}